# No API key is required for the prototype business finder.
# It uses OpenStreetMap + Nominatim + Overpass.

# Optional logo fallbacks. The resolver still works without these.
# LOGO_DEV_TOKEN=
# BRANDFETCH_CLIENT_ID=
# Optional Google image-search fallback. GOOGLE_PLACES_API_KEY can be reused
# only if Custom Search API is enabled in the same Google Cloud project.
# GOOGLE_CUSTOM_SEARCH_KEY=
# GOOGLE_CUSTOM_SEARCH_CX=
# SearXNG is used as the no-key fallback for lesser-known businesses.
# For reliability, point this at your own instance; public instances may
# disable JSON responses or rate-limit automated requests.
# SEARXNG_URL=https://your-searxng-instance.example
